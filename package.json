{
  "name": "codeden-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @codeden/server --filter @codeden/web run dev",
    "build": "pnpm -r --filter=!codeden-monorepo run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:slow": "vitest run --mode slow",
    "e2e": "pnpm build && pnpm --filter @codeden/web e2e",
    "desktop:dev": "pnpm --filter @codeden/web build && pnpm --filter @codeden/desktop build && pnpm --filter @codeden/desktop dev",
    "desktop:build": "pnpm build && pnpm --filter @codeden/desktop package --dir",
    "desktop:dist": "pnpm build && pnpm --filter @codeden/desktop package",
    "e2e:desktop": "pnpm desktop:build && pnpm --filter @codeden/desktop e2e",
    "db:generate": "pnpm --filter @codeden/server run db:generate",
    "changelog:preview": "node scripts/release/bump-version.mjs patch --dry-run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
