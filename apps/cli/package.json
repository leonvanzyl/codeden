{
  "name": "codeden",
  "version": "0.6.1",
  "description": "A local-first harness for coding agents: Claude Code, Codex and OpenCode sessions, an orchestrator and project managers, an inbox, GitHub traceability, automations and an experimental dark factory.",
  "license": "MIT",
  "author": "Leon van Zyl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonvanzyl/codeden.git",
    "directory": "apps/cli"
  },
  "homepage": "https://www.codeden.app",
  "bugs": {
    "url": "https://github.com/leonvanzyl/codeden/issues"
  },
  "type": "module",
  "bin": {
    "codeden": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "coding-agents",
    "ai-agents",
    "agent-harness",
    "harness",
    "claude-code",
    "claude",
    "codex",
    "openai-codex",
    "opencode",
    "orchestration",
    "automation",
    "software-factory",
    "github",
    "git-worktree",
    "mcp",
    "developer-tools",
    "local-first"
  ],
  "scripts": {
    "build": "tsdown && node scripts/copy-assets.mjs",
    "prepack": "node scripts/copy-readme.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.2",
    "node-pty": "1.1.0",
    "playwright-core": "1.64.1"
  },
  "devDependencies": {
    "@codeden/contracts": "workspace:*",
    "@codeden/providers": "workspace:*",
    "@codeden/runner": "workspace:*",
    "@codeden/server": "workspace:*",
    "@codeden/web": "workspace:*",
    "tsdown": "^0.23.7"
  }
}
